# ==========================================
# Database Manipulator using MCP - .gitignore
# ==========================================

# 1. Environment & API Secrets (CRITICAL: Never commit API keys!)
.env
*.env
.env.*
!.env.example

# 2. Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# 4. Databases & SQLite Runtime Data
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.sqlite
data/*.db
data/uploads/
**/data/uploads/
**/data/*.sqlite
**/data/*.db
!**/data/sample*.csv
!**/data/sample*.xlsx

# 5. OS & Editor Specific Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 6. Node / Frontend Build Outputs (if applicable)
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. Logs & Temporary Data
*.log
logs/
temp/
tmp/
